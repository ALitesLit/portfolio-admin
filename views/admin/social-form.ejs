<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white m-0"><%= socialNetwork ? 'Редактировать социальную сеть' : 'Новая социальная сеть' %></h2>

    <a href="/admin/social" class="btn btn-outline-light">
        <span class="material-icons align-middle">arrow_back</span>
        Назад
    </a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<form
    method="POST"
    action="<%= socialNetwork ? '/admin/social/' + socialNetwork.id : '/admin/social/new' %>"
    enctype="multipart/form-data"
>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="mb-3">
        <label class="form-label">Название</label>

        <input
            type="text"
            name="name"
            class="form-control"
            value="<%= socialNetwork ? socialNetwork.name : '' %>"
            required
        >
    </div>

    <div class="mb-3">
        <label class="form-label">Ссылка</label>

        <input
            type="url"
            name="site"
            class="form-control"
            value="<%= socialNetwork ? socialNetwork.site || '' : '' %>"
            placeholder="https://"
        >
    </div>

    <div class="mb-3">
        <label class="form-label">Изображение</label>

        <input
            type="file"
            name="photo"
            class="form-control"
            accept=".png,.svg,image/png,image/svg+xml"
            <%= socialNetwork ? '' : 'required' %>
        >
    </div>

    <% if (socialNetwork && socialNetwork.photo) { %>
        <div class="mb-3">
            <img
                src="<%= socialNetwork.photo %>"
                alt=""
                style="max-width: 200px; max-height: 200px;"
            >
        </div>
    <% } %>

    <button type="submit" class="btn btn-primary">
        Сохранить
    </button>
</form>

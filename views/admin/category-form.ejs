<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white m-0"><%= category ? 'Редактировать категорию' : 'Новая категория' %></h2>

    <a href="/admin/categories" class="btn btn-outline-light">
        <span class="material-icons align-middle">arrow_back</span>
        Назад
    </a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<form method="POST" action="<%= category ? '/admin/categories/' + category.id : '/admin/categories/new' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="mb-3">
        <label class="form-label">Название</label>

        <input
            type="text"
            name="name"
            class="form-control"
            value="<%= category ? category.name : '' %>"
            required
        >
    </div>

    <div class="mb-3 form-check">
        <input
            type="checkbox"
            name="onHide"
            class="form-check-input"
            id="onHide"
            <%= category && category.on_hide ? 'checked' : '' %>
        >

        <label class="form-check-label" for="onHide">
            Скрыть категорию
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Сохранить
    </button>
</form>

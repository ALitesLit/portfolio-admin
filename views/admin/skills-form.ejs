<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white m-0"><%= skill ? 'Редактировать навык' : 'Новый навык' %></h2>

    <a href="/admin/skills" class="btn btn-outline-light">
        <span class="material-icons align-middle">arrow_back</span>
        Назад
    </a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<form method="POST" action="<%= skill ? '/admin/skills/' + skill.id : '/admin/skills/new' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="mb-3">
        <label class="form-label">Название</label>

        <input
            type="text"
            name="name"
            class="form-control"
            value="<%= skill ? skill.name : '' %>"
            required
        >
    </div>

    <div class="mb-3">
        <label class="form-label">Категория</label>

        <select name="categoryId" class="form-select" required>
            <option value="">— Выберите —</option>

            <% categories.forEach(category => { %>
                <option
                    value="<%= category.id %>"
                    <%= skill && skill.categoryId === category.id ? 'selected' : '' %>
                >
                    <%= category.name %>
                </option>
            <% }) %>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Важность</label>

        <input
            type="number"
            name="importance"
            class="form-control"
            value="<%= skill ? skill.importance : 0 %>"
            min="0"
        >
    </div>

    <button type="submit" class="btn btn-primary">
        Сохранить
    </button>
</form>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white m-0">Сертификаты</h2>
    <a href="/admin/sertifies/new" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добавить
    </a>
</div>

<% if (sertifies.length === 0) { %>
    <div class="alert alert-secondary">Сертификатов пока нет</div>
<% } else { %>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Сайт</th>
                    <th>Изображение</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                <% sertifies.forEach(sertify => { %>
                    <tr>
                        <td><%= sertify.name %></td>
                        <td>
                            <% if (sertify.site) { %>
                                <a href="<%= sertify.site %>" target="_blank" rel="noopener noreferrer">
                                    <%= sertify.site %>
                                </a>
                            <% } %>
                        </td>
                        <td>
                            <% if (sertify.photo) { %>
                                <img src="<%= sertify.photo %>" alt="" style="max-height: 80px; max-width: 120px;">
                            <% } %>
                        </td>
                        <td class="text-end">
                            <a href="/admin/sertifies/<%= sertify.id %>/edit" class="btn btn-sm btn-outline-light">
                                <span class="material-icons">edit</span>
                            </a>
                            <form method="POST" action="/admin/sertifies/<%= sertify.id %>/delete" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <span class="material-icons">delete</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

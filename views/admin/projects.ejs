<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white m-0">Проекты</h2>
    <a href="/admin/projects/new" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добавить
    </a>
</div>

<% if (projects.length === 0) { %>
    <div class="alert alert-secondary">Проектов пока нет</div>
<% } else { %>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Ссылка</th>
                    <th>Важность</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                <% projects.forEach(project => { %>
                    <tr>
                        <td><%= project.name %></td>
                        <td><%= project.short_deskription || '' %></td>
                        <td>
                            <% if (project.site) { %>
                                <a href="<%= project.site %>" target="_blank" rel="noopener noreferrer">
                                    <%= project.site %>
                                </a>
                            <% } %>
                        </td>
                        <td><%= project.importance %></td>
                        <td class="text-end">
                            <a href="/admin/projects/<%= project.id %>/edit" class="btn btn-sm btn-outline-light">
                                <span class="material-icons">edit</span>
                            </a>
                            <form method="POST" action="/admin/projects/<%= project.id %>/delete" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <span class="material-icons">delete</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

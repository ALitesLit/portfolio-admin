<div class="container">
    <div class="row justify-content-center" style="margin-top: 10vh;">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow">
                <div class="card-body">
                    <h1 class="h4 mb-4 text-center text-white">Вход в админку</h1>

                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                    <% } %>

                    <form method="POST" action="/login">
                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        >

                        <div class="mb-3">
                            <label class="form-label">Имя</label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                value="<%= name %>"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Пароль</label>

                            <input
                                type="password"
                                name="password"
                                class="form-control"
                                required
                            >
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Войти
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

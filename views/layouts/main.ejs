<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <style>
        body {
            background: #0d1117;
        }

        .sidebar {
            min-height: calc(100vh - 56px);
            background: #161b22;
        }

        .sidebar .nav-link {
            color: #8b949e;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #ffffff;
            background: #21262d;
        }

        .card {
            background: #161b22;
            border-color: #30363d;
        }

        .table {
            --bs-table-bg: #161b22;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark border-bottom">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin">Admin Panel</a>

            <div class="d-flex align-items-center gap-3">
                <% if (user) { %>
                    <span class="text-white"><%= user.name %></span>

                    <form method="POST" action="/logout" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <button type="submit" class="btn btn-sm btn-outline-light">
                            Выйти
                        </button>
                    </form>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-md-block sidebar border-end" style="border-color: #30363d !important;">
                <ul class="nav flex-column pt-3">
                    <li class="nav-item">
                        <a class="nav-link <%= req.path === '/admin' ? 'active' : '' %>" href="/admin">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= req.path.startsWith('/admin/projects') ? 'active' : '' %>" href="/admin/projects">
                            <i class="bi bi-folder"></i> Проекты
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= req.path.startsWith('/admin/categories') ? 'active' : '' %>" href="/admin/categories">
                            <i class="bi bi-tags"></i> Категории
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= req.path.startsWith('/admin/sertifies') ? 'active' : '' %>" href="/admin/sertifies">
                            <i class="bi bi-award"></i> Сертификаты
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= req.path.startsWith('/admin/skills') ? 'active' : '' %>" href="/admin/skills">
                            <i class="bi bi-lightning"></i> Навыки
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= req.path.startsWith('/admin/social') ? 'active' : '' %>" href="/admin/social">
                            <i class="bi bi-share"></i> Соцсети
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= req.path.startsWith('/admin/auth-log') ? 'active' : '' %>" href="/admin/auth-log">
                            <i class="bi bi-shield-lock"></i> Журнал входов
                        </a>
                    </li>
                </ul>
            </nav>

            <main class="col-md-9 col-lg-10 py-4">
                <%- body %>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
